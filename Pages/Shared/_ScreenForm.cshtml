@model ScreenModel
@{
    var s = Model.Screen;
    var multipart = s.Fields.Any(f => f.Type == FT.File);
}
<form method="post" enctype="@(multipart ? "multipart/form-data" : "application/x-www-form-urlencoded")" novalidate class="card card-body mb-4">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">Revisa los campos marcados.</div>
    }
    <div class="row">
        @foreach (var f in s.Fields)
        {
            <div class="@(f.Type == FT.TextArea ? "col-12" : "col-md-6")">
                @await Html.PartialAsync("_Field", new FieldVm(f, Model.Values.GetValueOrDefault(f.Name), Model.Errors.GetValueOrDefault(f.Name), "f-"))
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        @if (s.CancelTo is not null)
        {
            <a class="btn btn-light" href="@Catalog.Url(s.CancelTo, Model.RouteId)">Cancelar</a>
        }
    </div>
</form>