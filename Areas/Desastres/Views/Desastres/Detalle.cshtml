@model DesastreDto
<h1 class="h4 mb-3">@Model.Nombre</h1>
<div class="card mb-3"><div class="card-body">
  <dl class="row mb-0">
    <dt class="col-sm-3">Ubicación</dt><dd class="col-sm-9">@Model.Ubicacion</dd>
    <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.Descripcion</dd>
    <dt class="col-sm-3">Severidad</dt><dd class="col-sm-9">@Model.Severidad</dd>
    <dt class="col-sm-3">Fase</dt><dd class="col-sm-9">@Model.Phase (v@(Model.Version))</dd>
    <dt class="col-sm-3">Coordenadas</dt><dd class="col-sm-9">@Model.Latitud, @Model.Longitud @(Model.Radio is { } r ? $"(radio {r:N0} m)" : "")</dd>
  </dl>
</div></div>
<div class="d-flex gap-2 flex-wrap">
  <a class="btn btn-outline-primary btn-sm" href="/Desastres/@Model.Id/Fuentes">Fuentes y reportes</a>
  <a class="btn btn-outline-primary btn-sm" href="/Desastres/@Model.Id/Organismos">Organismos</a>
  <a class="btn btn-outline-primary btn-sm" href="/Desastres/@Model.Id/Alertas">Alertas</a>
  <a class="btn btn-outline-secondary btn-sm" href="/Desastres/Lista">Volver</a>
</div>
