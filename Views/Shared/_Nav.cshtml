@{
    var path = Context.Request.Path.Value ?? "/";
    bool On(string p) => p == "/" ? path == "/" : path.StartsWith(p, StringComparison.OrdinalIgnoreCase);

    var items = new (string Text, string Href, string Prefix)[]
    {
        ("Inicio", "/", "/"),
        ("Desastres", "/Desastres", "/Desastres"),
        ("Daños", "/Danos", "/Danos"),
        ("Personas afectadas", "/Personas", "/Personas"),
        ("Recursos", "/Recursos", "/Recursos"),
        ("Organizaciones", "/Organizaciones", "/Organizaciones"),
        ("Reconstrucción", "/Reconstruccion", "/Reconstruccion"),
    };
    var disasterId = Context.Request.Query["disasterId"].ToString();
    var isSystem = path.StartsWith("/Auditoria", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Integraciones", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Administracion", StringComparison.OrdinalIgnoreCase);
}
<nav class="navbar navbar-expand-xl navbar-dark bg-dark no-print">
    <div class="container-xl">
        <a class="navbar-brand" href="/">Gestión de Desastres</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                @foreach (var it in items)
                {
                    <li class="nav-item">
                        <a class="@("nav-link" + (On(it.Prefix) ? " active" : ""))" href="@it.Href">@it.Text</a>
                    </li>
                }
                <li class="nav-item dropdown">
                    <a class="@("nav-link dropdown-toggle" + (isSystem ? " active" : ""))" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">Sistema</a>
                    <ul class="dropdown-menu">
                        <li><a class="@("dropdown-item" + (On("/Auditoria") ? " active" : ""))" href="/Auditoria">Auditoría</a></li>
                        <li><a class="@("dropdown-item" + (On("/Integraciones") ? " active" : ""))" href="/Integraciones">Integraciones</a></li>
                        <li><a class="@("dropdown-item" + (On("/Administracion") ? " active" : ""))" href="/Administracion">Administración</a></li>
                    </ul>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-3 text-light small">
                @if (!string.IsNullOrEmpty(disasterId))
                {
                    <span class="badge text-bg-secondary">Desastre @disasterId</span>
                }
                <span>@(User.Identity?.Name ?? "Sin sesión")@(User.FindFirst("organization")?.Value is { } org ? " · " + org : "")</span>
                <form method="post" action="/Cuenta/Salir" class="m-0">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-light" type="submit">Salir</button>
                </form>
            </div>
        </div>
    </div>
</nav>