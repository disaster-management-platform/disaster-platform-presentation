@model PantallaVm
@{
    var s = Model.Screen;
    var multipart = s.Fields.Any(f => f.Type == FT.File);
    var activities = Model.Values.GetValueOrDefault("activities") ?? "";
}
<form method="post" enctype="@(multipart ? "multipart/form-data" : "application/x-www-form-urlencoded")" novalidate class="card card-body mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Key" value="@Model.Key" />
    <input type="hidden" name="Values[expectedVersion]" value="@Model.Values.GetValueOrDefault("expectedVersion")" />
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">Revisa los campos marcados.</div>
    }
    <div class="row">
        @foreach (var f in s.Fields.Where(f => s.Id != "REC-06" || f.Name != "activities"))
        {
            <div class="@(f.Type == FT.TextArea ? "col-12" : "col-md-6")">
                @await Html.PartialAsync("_Field", new FieldVm(f, Model.Values.GetValueOrDefault(f.Name), Model.Errors.GetValueOrDefault(f.Name), "f-"))
            </div>
        }
    </div>
    @if (s.Id == "REC-06")
    {
        <section class="mb-4" data-schedule-editor>
            <h2 class="h5">Cronograma</h2>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tarea</th>
                            <th>Responsable</th>
                            <th>Fecha de inicio</th>
                            <th>Fecha de vencimiento</th>
                            <th>Presupuesto</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody data-schedule-rows></tbody>
                </table>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-add-activity>Agregar actividad</button>
            <p class="mt-3 mb-0" data-budget-summary></p>
        </section>
        <input type="hidden" id="f-activities" name="Values[activities]" value="@activities" data-schedule-value />
        @if (Model.Errors.TryGetValue("activities", out var activitiesError))
        {
            <div class="text-danger small mb-3">@activitiesError</div>
        }
    }
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit" disabled="@(Model.Unsupported != null || s.Id == "REC-12" && !string.Equals(Model.ProjectStatus, "Monitoring", StringComparison.OrdinalIgnoreCase))">Guardar</button>
        @if (s.CancelTo is not null)
        {
            <a class="btn btn-light" href="@Catalog.Url(s.CancelTo, Model.RouteId)">Cancelar</a>
        }
    </div>
</form>