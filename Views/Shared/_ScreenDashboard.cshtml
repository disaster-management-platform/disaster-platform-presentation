@model PantallaVm
@{
    var s = Model.Screen;
}
@if (s.Stats.Length > 0)
{
    <div class="row g-3 mb-4">
        @foreach (var st in s.Stats)
        {
            <div class="col-6 col-lg">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@st.Label</div>
                        <div class="fs-2 fw-semibold">@(Model.Simulado ? st.Value : "—")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}
@if (s.Map)
{
    <div class="row g-3 mb-4 align-items-start">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header fw-semibold">Mapa</div>
                <div id="map" class="map" data-points="@(Model.Simulado ? Mock.PointsJson(false) : "[]")"></div>
            </div>
        </div>
        @if (s.Cols.Length > 0)
        {
            <div class="col-lg-6">
                @await Html.PartialAsync("_Table", new TableVm(s.TableTitle, s.Cols, s.RowTo, s.Filters) { Rows = Model.Filas, Selectable = s.Selectable })
            </div>
        }
    </div>
}
@if (s.Chart && !s.Map && Model.Simulado)
{
    <partial name="_ScreenChart" model="Model" />
}
@if (s.Cols.Length > 0 && !s.Map)
{
    @await Html.PartialAsync("_Table", new TableVm(s.TableTitle, s.Cols, s.RowTo, s.Filters) { Rows = Model.Filas, Selectable = s.Selectable })
}