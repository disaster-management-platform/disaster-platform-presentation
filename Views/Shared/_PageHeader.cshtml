@model PantallaVm
@{
    var s = Model.Screen;
    var dashboardId = Catalog.DashboardId(s.Module);
    var hasActions = s.Links.Length > 0 || s.Dialogs.Length > 0 || s.Print;
}
<header class="page-header">
    <nav aria-label="breadcrumb" class="no-print">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="@Catalog.Url("HOME")">Inicio</a></li>
            @if (dashboardId is not null && s.Id != "HOME")
            {
                <li class="breadcrumb-item"><a href="@Catalog.Url(dashboardId)">@s.Module</a></li>
            }
            @if (Model.Parent is { } parent && parent.Id != "HOME" && parent.Id != dashboardId)
            {
                <li class="breadcrumb-item"><a href="@Catalog.Url(parent.Id, Model.RouteId)">@parent.Title</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@s.Title</li>
        </ol>
    </nav>
    <div class="page-header__content d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
        <div class="page-header__main flex-grow-1">
            <div class="page-header__eyebrow d-flex flex-wrap align-items-center gap-2">
                <span class="badge text-bg-light border">@s.Id</span>
                @if (s.Optional) { <span class="badge text-bg-light border">Opcional</span> }
                @if (Model.RouteId is { } routeId)
                {
                    var context = s.Module == "Gestión de desastres" && int.TryParse(routeId, out _)
                        ? $"Desastre #{routeId}"
                        : $"Registro {routeId}";
                    <span class="badge text-bg-light border">@context</span>
                }
            </div>
            <h1 class="page-header__title">@s.Title</h1>
            @if (!string.IsNullOrWhiteSpace(s.Intro))
            {
                <p class="page-header__subtitle">@s.Intro</p>
            }
        </div>
        @if (hasActions)
        {
            <div class="page-header__actions d-flex flex-wrap gap-2 no-print">
                @foreach (var l in s.Links)
                {
                    <a class="@("btn " + (l.Primary ? "btn-primary" : "btn-outline-secondary"))" href="@Catalog.Url(l.To, Model.RouteId)">@l.Label</a>
                }
                @foreach (var d in s.Dialogs)
                {
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#dlg-@d.Id">@d.Label</button>
                }
                @if (s.Print) { <button type="button" class="btn btn-outline-dark" onclick="window.print()">Imprimir</button> }
            </div>
        }
    </div>
</header>
