@model PantallaVm
@using System.Text.Json
@{
    var s = Model.Screen;
    var cols = s.Cols;
    var rows = Model.Filas ?? Mock.Rows(s.Cols, s.RowTo).ToArray();
    var tableTitle = s.TableTitle;
    if (s.Map && s.Kind == Kind.Detail)
    {
        var index = Mock.ChartTableIndex(s.Tables);
        if (index >= 0)
        {
            var table = s.Tables[index];
            cols = table.Cols;
            rows = Model.FilasSub.GetValueOrDefault(index) ?? Mock.Rows(table.Cols, table.RowTo).ToArray();
            tableTitle = table.Title;
        }
    }
    var hasMillionUnit = s.ChartTitle?.Contains("(millones COP)", StringComparison.OrdinalIgnoreCase) == true;
    var bars = s.Map || hasMillionUnit
        ? Mock.ChartBars(cols, rows, s.Map)
        : Mock.BarsFor(s);
    var title = s.ChartTitle ?? (s.Map ? Mock.ChartTitleFor(cols, tableTitle) : "Resumen");
    var scale = hasMillionUnit ? 1_000_000m : 1m;
    var chartData = bars.Select(bar => new { label = Etiquetas.Es(bar.Zone), value = bar.Count / scale }).ToArray();
    var max = chartData.Length == 0 ? 1m : Math.Max(1m, chartData.Max(bar => bar.value));
    var chartType = Mock.ChartTypeFor(s.Id);
}
@if (bars.Length > 0)
{
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">@title</span>
            <div class="btn-group btn-group-sm no-print" role="group" aria-label="Tipo de gráfico" data-chart-controls>
                <button type="button" class="btn @(chartType == "bars" ? "btn-secondary" : "btn-outline-secondary")"
                        data-chart-type="bars" aria-pressed="@(chartType == "bars" ? "true" : "false")">Barras</button>
                <button type="button" class="btn @(chartType == "columns" ? "btn-secondary" : "btn-outline-secondary")"
                        data-chart-type="columns" aria-pressed="@(chartType == "columns" ? "true" : "false")">Columnas</button>
                <button type="button" class="btn @(chartType == "pie" ? "btn-secondary" : "btn-outline-secondary")"
                        data-chart-type="pie" aria-pressed="@(chartType == "pie" ? "true" : "false")">Pastel</button>
            </div>
        </div>
        <div class="card-body">
            <div data-interactive-chart data-chart-title="@title" data-chart-type="@chartType" data-chart-values="@JsonSerializer.Serialize(chartData)">
                <div class="chart-canvas" data-chart-canvas>
                    @foreach (var bar in chartData)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <span>@bar.label</span>
                                <span>@bar.value</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@bar.value" aria-valuemin="0" aria-valuemax="@max">
                                <div class="progress-bar" style="width:@((int)Math.Round(bar.value * 100 / max))%"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="chart-legend" data-chart-legend></div>
                <p class="small text-muted mt-2 mb-0" data-chart-summary aria-live="polite">
                    Selecciona una categoría para resaltarla.
                </p>
            </div>
        </div>
    </div>
}
