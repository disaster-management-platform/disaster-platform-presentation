@model PantallaVm
@{
    var s = Model.Screen;
}
@if (s.Kind == Kind.Auth)
{
    <partial name="_ScreenAuth" model="Model" />
}
else
{
    if (Model.Parent is { } parent)
    {
        <a class="btn btn-sm btn-outline-secondary mb-2 no-print" href="@Catalog.Url(parent.Id, Model.RouteId)">← Volver a @parent.Title</a>
    }
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
        <div>
            <div class="text-muted small">
                @s.Module
                <span class="badge text-bg-secondary ms-1">@s.Id</span>
                @if (s.Optional) { <span class="badge text-bg-light border ms-1">Opcional</span> }
            </div>
            <h1 class="h3 mb-0">@s.Title</h1>
            @if (Model.RouteId is not null) { <div class="small text-muted">Contexto: @Model.RouteId</div> }
        </div>
        <div class="d-flex flex-wrap gap-2 no-print">
            @foreach (var l in s.Links)
            {
                <a class="@("btn " + (l.Primary ? "btn-primary" : "btn-outline-secondary"))" href="@Catalog.Url(l.To, Model.RouteId)">@l.Label</a>
            }
            @foreach (var d in s.Dialogs)
            {
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#dlg-@d.Id">@d.Label</button>
            }
            @if (s.Print) { <button type="button" class="btn btn-outline-dark" onclick="window.print()">Imprimir</button> }
        </div>
    </div>

    @if (Model.Flash is not null) { <div class="alert alert-success">@Model.Flash</div> }
    @if (Model.FlashError is not null) { <div class="alert alert-danger">@Model.FlashError</div> }
    @if (s.Intro is not null) { <p class="text-muted">@s.Intro</p> }

    @switch (s.Kind)
    {
        case Kind.Dashboard:
            <partial name="_ScreenDashboard" model="Model" />
            break;
        case Kind.List:
            @await Html.PartialAsync("_Table", new TableVm(s.TableTitle, s.Cols, s.RowTo, s.Filters) { Rows = Model.Filas })
            break;
        case Kind.Detail:
            <partial name="_ScreenDetail" model="Model" />
            break;
        case Kind.Form:
            <partial name="_ScreenForm" model="Model" />
            break;
    }

    @for (var i = 0; i < s.Tables.Length; i++)
    {
        var t = s.Tables[i];
        @await Html.PartialAsync("_Table", new TableVm(t.Title, t.Cols, t.RowTo, Array.Empty<Field>(), false) { Rows = Model.FilasSub.GetValueOrDefault(i) })
    }

    <partial name="_Dialogs" model="Model" />

    <div class="mt-4 pt-2 border-top small text-muted no-print">
        <span class="badge text-bg-light border">@s.State</span> @s.Api
        <div>A = API existente · N = contrato propuesto · E = adaptador Integration Service pendiente</div>
    </div>
}