@model PantallaVm
@{
    var s = Model.Screen;
    var hasActions = s.Links.Length > 0 || s.Dialogs.Length > 0 || s.Print;
}
@if (s.Kind == Kind.Auth)
{
    <partial name="_ScreenAuth" model="Model" />
}
else
{
    <partial name="_PageHeader" model="Model" />

    @if (s.Stage is { } stage)
    {
        <partial name="_FlujoReconstruccion" model="Model" />
    }

    @if (hasActions)
    {
        <div class="d-flex flex-wrap gap-2 mb-4 no-print">
            @foreach (var l in s.Links)
            {
                <a class="@("btn px-3 " + (l.Primary ? "btn-primary" : "btn-outline-secondary"))" href="@Catalog.Url(l.To, Model.RouteId)">@l.Label</a>
            }
            @foreach (var d in s.Dialogs)
            {
                var isBulkProjects = s.Id == "REC-02" && d.Id == "proyectos";
                var isBlockedClose = s.Id == "REC-13" && d.Id == "cerrar" && !Model.CanFinalize;
                <button type="button" class="btn btn-outline-primary px-3" data-bs-toggle="modal" data-bs-target="#dlg-@d.Id"
                        disabled="@(isBulkProjects || isBlockedClose)" data-selection-launch="@(isBulkProjects ? "true" : null)">@d.Label</button>
            }
            @if (s.Print) { <button type="button" class="btn btn-outline-dark px-3" onclick="window.print()">Imprimir</button> }
        </div>
    }

    @if (Model.Flash is not null) { <div class="alert alert-success">@Model.Flash</div> }
    @if (Model.FlashError is not null) { <div class="alert alert-danger">@Model.FlashError</div> }

    @if (s.Stage == 3 && string.Equals(Model.ProjectStatus, "Draft", StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-warning" role="alert">
            El proyecto aún no está formalizado. Completa la formalización para iniciar el monitoreo.
            <a href="@Catalog.Url("REC-06", Model.RouteId)">Completar formalización</a>
        </div>
    }

    @if (s.Id == "REC-13" && !Model.CanFinalize)
    {
        <div class="alert alert-warning" role="alert">
            No se puede cerrar el proyecto mientras existan actividades incompletas o reportes pendientes.
            @if (Model.ActivitiesWithoutReports is > 0)
            {
                <span>Hay @Model.ActivitiesWithoutReports actividades sin reporte.</span>
            }
            <a href="@Catalog.Url("REC-08", Model.RouteId)">Revisar cronograma</a> ·
            <a href="@Catalog.Url("REC-12", Model.RouteId)">Registrar reportes</a>
        </div>
    }

    @switch (s.Kind)
    {
        case Kind.Dashboard:
            <partial name="_ScreenDashboard" model="Model" />
            break;
        case Kind.List:
            @await Html.PartialAsync("_Table", new TableVm(s.TableTitle, s.Cols, s.RowTo, s.Filters) { Rows = Model.Filas, Selectable = s.Selectable })
            break;
        case Kind.Detail:
            <partial name="_ScreenDetail" model="Model" />
            break;
        case Kind.Form:
            <partial name="_ScreenForm" model="Model" />
            break;
    }

    @if (!(s.Map && s.Kind == Kind.Detail))
    {
        @for (var i = 0; i < s.Tables.Length; i++)
        {
            var t = s.Tables[i];
            @await Html.PartialAsync("_Table", new TableVm(t.Title, t.Cols, t.RowTo, Array.Empty<Field>(), false) { Rows = Model.FilasSub.GetValueOrDefault(i) })
        }
    }
    @if (s.Map)
    {
        <partial name="_ScreenChart" model="Model" />
    }

    <partial name="_Dialogs" model="Model" />

    <div class="mt-4 pt-2 border-top small text-muted no-print">
        <span class="badge text-bg-light border">@s.State</span> @s.Api
        <div>A = API existente · N = contrato propuesto · E = adaptador Integration Service pendiente</div>
    </div>
}