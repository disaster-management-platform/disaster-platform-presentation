@model ScreenModel
@{
    var s = Model.Screen;
}
<div class="row justify-content-center pt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <div class="display-6 mb-1">Gestión de Desastres</div>
                <p class="text-muted">y Reconstrucción</p>
                <p class="small">@s.Intro</p>
                <a class="btn btn-primary w-100" href="@Catalog.Url("HOME")">@s.Links[0].Label</a>
            </div>
        </div>
        <div class="small text-muted text-center mt-3">@s.Api</div>
    </div>
</div>