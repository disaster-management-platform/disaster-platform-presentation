@model TableVm
@{
    var rows = (Model.Rows ?? Mock.Rows(Model.Cols, Model.RowTo)).ToArray();
    var attachments = rows.Any(x => x.Attachments?.Count > 0);
    var statusIndex = Array.FindIndex(Model.Cols, c => c.Key == "status");
}
<div class="card mb-4 table-card">
    @if (Model.Title is not null) { <div class="card-header fw-semibold">@Model.Title</div> }
    @if (Model.Search || Model.Filters.Length > 0)
    {
        <div class="card-body border-bottom py-2 no-print">
            <div class="row g-2">
                @if (Model.Search)
                {
                    @if (Context.Request.Path.Value?.TrimEnd('/') is "/Organizaciones" or "/Personas/Lista")
                    {
                        <form method="get" class="col-md-4 d-flex gap-2">
                            <input type="hidden" name="disasterId" value="@Context.Request.Query["disasterId"]" />
                            <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" placeholder="Buscar en el directorio…" />
                            <button class="btn btn-sm btn-outline-secondary">Buscar</button>
                        </form>
                    }
                    else
                    {
                        <div class="col-md-4"><input type="search" class="form-control form-control-sm" placeholder="Buscar en esta tabla…" data-table-search /></div>
                    }
                }
                @foreach (var f in Model.Filters)
                {
                    var idx = Array.FindIndex(Model.Cols, c => c.Key == f.Name);
                    if (idx < 0) { continue; }
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" data-table-filter="@idx">
                            <option value="">@f.Label (todos)</option>
                            @foreach (var o in f.Options ?? Array.Empty<string>()) { <option>@Etiquetas.Es(o)</option> }
                        </select>
                    </div>
                }
            </div>
        </div>
    }
    <div class="table-responsive @(rows.Length > 6 ? "table-scroll" : null)">
        <table class="table table-hover align-middle mb-0" data-selectable="@(Model.Selectable ? "true" : null)">
            <thead class="table-light">
                <tr>
                    @if (Model.Selectable) { <th scope="col" class="text-center"><input type="checkbox" class="form-check-input m-0" data-select-all aria-label="Seleccionar todas las propuestas" /></th> }
                    @foreach (var c in Model.Cols) { <th scope="col">@c.Label</th> }
                    @if (attachments) { <th scope="col">Archivos</th> }
                </tr>
            </thead>
            <tbody>
                @if (rows.Length == 0)
                {
                    <tr><td class="text-center text-muted py-4" colspan="@Math.Max(Model.Cols.Length + (Model.Selectable ? 1 : 0), 1)">No hay registros para mostrar.</td></tr>
                }
                else
                {
                    @foreach (var row in rows)
                    {
                        <tr data-href="@row.Href" class="@(row.Href is null ? null : "clickable")">
                            @if (Model.Selectable)
                            {
                                var status = statusIndex >= 0 && statusIndex < row.Cells.Length ? row.Cells[statusIndex].Text : "";
                                var disabled = row.Id is null || status.Equals("Selected", StringComparison.OrdinalIgnoreCase)
                                    || status.Equals("Obsolete", StringComparison.OrdinalIgnoreCase);
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input m-0" value="@row.Id" data-select-row
                                           disabled="@disabled" aria-label="Seleccionar propuesta" />
                                </td>
                            }
                            @foreach (var cell in row.Cells)
                            {
                                <td>@if (cell.Badge) { <span class="@Mock.Badge(cell.Text)">@Etiquetas.Es(cell.Text)</span> } else { @Etiquetas.Es(cell.Text) }</td>
                            }
                            @if (attachments) { <td>@foreach (var file in row.Attachments ?? []) { <a href="@file.Url" class="d-block">@file.Label</a> }</td> }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>