@model TableVm
<div class="card mb-4 table-card">
    @if (Model.Title is not null) { <div class="card-header fw-semibold">@Model.Title</div> }
    @if (Model.Search || Model.Filters.Length > 0)
    {
        <div class="card-body border-bottom py-2 no-print">
            <div class="row g-2">
                @if (Model.Search)
                {
                    <div class="col-md-4"><input type="search" class="form-control form-control-sm" placeholder="Buscar…" data-table-search /></div>
                }
                @foreach (var f in Model.Filters)
                {
                    var idx = Array.FindIndex(Model.Cols, c => c.Key == f.Name);
                    if (idx < 0) { continue; }
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" data-table-filter="@idx">
                            <option value="">@f.Label (todos)</option>
                            @foreach (var o in f.Options ?? Array.Empty<string>()) { <option>@o</option> }
                        </select>
                    </div>
                }
            </div>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr>@foreach (var c in Model.Cols) { <th>@c.Label</th> }</tr></thead>
            <tbody>
                @foreach (var row in (Model.Rows ?? Mock.Rows(Model.Cols, Model.RowTo)))
                {
                    <tr data-href="@row.Href" class="@(row.Href is null ? null : "clickable")">
                        @foreach (var cell in row.Cells)
                        {
                            <td>@if (cell.Badge) { <span class="@Mock.Badge(cell.Text)">@cell.Text</span> } else { @cell.Text }</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>